{
  "name": "dental-erp",
  "version": "2.1.2",
  "description": "Open-source dental hospital management system for Indian dental clinics — AI-powered, GST billing, patient portal, tele-dentistry",
  "private": true,
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "keywords": [
    "dental-software",
    "hospital-management-system",
    "dental-erp",
    "dental-clinic",
    "nextjs",
    "prisma",
    "india",
    "gst-billing",
    "patient-management",
    "appointment-scheduling",
    "open-source",
    "ai-powered",
    "tele-dentistry",
    "dental-practice-management"
  ],
  "author": "Abinauv Selvaraj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abinauv/dental-erp.git"
  },
  "homepage": "https://github.com/abinauv/dental-erp",
  "bugs": {
    "url": "https://github.com/abinauv/dental-erp/issues"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx lib/queue/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "storage:migrate": "npx tsx scripts/migrate-storage.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "visual:baseline": "playwright test -c playwright.visual.config.ts --update-snapshots=all",
    "visual:compare": "playwright test -c playwright.visual.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@hookform/resolvers": "^7.0.3",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.106.1",
    "@types/nodemailer": "^7.0.5",
    "autoprefixer": "^10.6.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.18",
    "bullmq": "^6.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "postcss": "^8.5.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.5",
    "axe-core": "^4.11.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "prisma": "5.22.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    }
  }
}
