# =============================================================
# DentalERP — production environment
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# This one file is read twice: docker compose interpolates ${...} from it, and
# the app container receives it as its environment. Anything with a real value
# here is a secret — it holds database credentials, the session signing key and
# the key your payment-gateway credentials are encrypted with.
#
# Differences from .env.example, which is for development:
#   - hostnames are compose service names (mysql), not localhost
#   - nothing has a working default; the stack refuses to start without these
#   - NEXTAUTH_URL must be the public HTTPS URL, or logins will not work
# =============================================================

# ── Version to run ───────────────────────────────────────────
# Pin this to a release tag. "latest" means your next `docker compose pull`
# silently changes versions, which is not what you want for a system holding
# patient records — you want to choose when that happens and have a rollback
# target you can name.
DENTAL_ERP_VERSION="latest"

# ── Database ─────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# base64url deliberately: DATABASE_URL is a URL, and a password containing
# @ : / ? # or % will break parsing in ways that look like an auth failure.
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""
MYSQL_USER="dental"
MYSQL_DATABASE="dental_erp"

# Prisma connections per app replica. The arithmetic that matters:
#   replicas x DB_CONNECTION_LIMIT + headroom < MYSQL_MAX_CONNECTIONS
# Leave both alone for a single instance. DATABASE_URL itself is built by
# docker-compose.yml from the values above — do not set it here.
DB_CONNECTION_LIMIT="10"
MYSQL_MAX_CONNECTIONS="151"

# ── Where the app is published ───────────────────────────────
# 127.0.0.1 means the app is reachable only through a reverse proxy on this
# host, which is what you want. Using docker-compose.caddy.yml? Leave these.
APP_BIND="127.0.0.1"
APP_PORT="3000"

# ── TLS via Caddy — only read by docker-compose.caddy.yml ────
# Both are required when you use that overlay. The domain's DNS must already
# point here: certificate issuance is an HTTP challenge on port 80 and cannot
# succeed before it resolves.
DENTAL_ERP_DOMAIN="dental.example.com"
# Let's Encrypt sends renewal failures here. It is the only warning you get
# before a certificate expires.
ACME_EMAIL=""

# ── NextAuth (REQUIRED) ──────────────────────────────────────
# The public URL, with https. Getting this wrong produces redirect loops and
# cookies that are set on the wrong host.
NEXTAUTH_URL="https://dental.example.com"
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── Encryption (REQUIRED) ────────────────────────────────────
# AES-256-GCM: exactly 64 hex characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this later makes every stored payment-gateway credential
# undecryptable. Back it up somewhere other than this server.
ENCRYPTION_KEY=""

# ── Cron authentication (REQUIRED) ───────────────────────────
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""

# ── Application ──────────────────────────────────────────────
NODE_ENV="production"

# ── File storage ─────────────────────────────────────────────
# "local" keeps files in the `uploads` volume — correct for one instance, and
# what the backup script covers. Switch to "s3" if you run more than one
# replica or your host's filesystem is ephemeral. Read docs/STORAGE.md before
# switching: the files do not move on their own.
STORAGE_DRIVER="local"
MAX_FILE_SIZE="10485760"

# Only read when STORAGE_DRIVER="s3".
# S3_ENDPOINT=""            # omit entirely for real AWS S3
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY=""          # omit both keys on EC2/ECS/EKS to use the instance role
# S3_SECRET_KEY=""
# S3_FORCE_PATH_STYLE="true"  # needed by MinIO and most non-AWS implementations

# ── Redis — optional, nothing uses it yet ────────────────────
# Only meaningful with `docker compose --profile redis up -d`.
# REDIS_URL="redis://redis:6379"

# ── Email (SMTP) — optional but strongly recommended ─────────
# Without this, password resets and appointment reminders silently do nothing.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Optional integrations ────────────────────────────────────
OPENROUTER_API_KEY=""
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"
JITSI_DOMAIN="meet.jit.si"
