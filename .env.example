# =============================================================
# DentalERP Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ── Database (MySQL) ──────────────────────────────────────────
# Replace 'root' and 'password' with your MySQL credentials.
# Using docker-compose.dev.yml? The matching value is:
#   DATABASE_URL="mysql://root:dental@localhost:3306/dental_erp"
DATABASE_URL="mysql://root:password@localhost:3306/dental_erp"

# ── Auth (Better Auth) ────────────────────────────────────────
# NEXTAUTH_URL is the app's public base URL; NEXTAUTH_SECRET signs sessions and
# the mobile/patient JWTs (keep the names — the mobile and patient-portal token
# paths read NEXTAUTH_SECRET directly).
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── Single Sign-On (OIDC) — Optional ──────────────────────────
# Leave OIDC_ISSUER unset for credentials-only login (no UI change). Set all
# four to add an SSO button that signs existing staff in via your identity
# provider (account is matched by verified email). No provider is bundled.
# OIDC_ISSUER="https://login.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# Must mirror OIDC_ISSUER being set, so the login page shows the SSO button.
# NEXT_PUBLIC_OIDC_ENABLED="true"

# ── File Storage ──────────────────────────────────────────────
# "local" (default) or "s3". Local disk is correct for a single instance and
# needs nothing else running. See docs/STORAGE.md for how to choose, and for
# the one-command migration between them.
STORAGE_DRIVER="local"
# Where the local driver keeps files. Relative paths resolve against the
# application directory.
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ── Object Storage (S3-compatible) — Optional ───────────────────
# Only read when STORAGE_DRIVER="s3". Works against MinIO, AWS S3, Cloudflare
# R2, DigitalOcean Spaces and anything else speaking the same API.
#
# Setting these alone changes nothing: the driver switch is STORAGE_DRIVER, and
# it is separate on purpose, because your existing files do not move on their
# own. Copy them across first — `npm run storage:migrate -- --dry-run`.
#
# The values below match docker-compose.dev.yml.
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="dentalerp"
# S3_SECRET_KEY="dentalerp123"
# S3_BUCKET="dental-erp-uploads"
# S3_REGION="us-east-1"
# MinIO and most non-AWS S3 implementations need path-style addressing
# S3_FORCE_PATH_STYLE="true"

# ── Cache / Queue (Redis) — Optional ────────────────────────────
# Leave unset and background jobs (email/SMS dispatch, communication triggers)
# run inline in the web request, and caching/rate limiting stay in-process —
# correct for a single instance. Set it to move jobs onto a durable BullMQ queue
# (retries, survives restarts) processed by `npm run worker`; also needed once
# you run more than one instance.
# REDIS_URL="redis://localhost:6379"
# Max jobs the worker processes at once (default 5).
# QUEUE_CONCURRENCY="5"

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"
# Log verbosity for the structured (pino) logger: trace|debug|info|warn|error|
# fatal. Defaults to debug in development, info in production.
# LOG_LEVEL="debug"

# ── Payment Gateway Encryption (REQUIRED) ─────────────────────
# AES-256-GCM needs a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Cron Jobs Security (REQUIRED) ────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""

# ── AI provider — Optional ────────────────────────────────────
# Required only for AI features (treatment advisor, smart scheduler, etc.).
# Pick the backend; unset ⇒ openrouter (the zero-config default).
# AI_PROVIDER="openrouter"   # openrouter | anthropic | bedrock

# openrouter (default): sign up at https://openrouter.ai for a key.
OPENROUTER_API_KEY=""
# anthropic (AI_PROVIDER=anthropic): Claude via the Anthropic API.
# ANTHROPIC_API_KEY=""
# bedrock (AI_PROVIDER=bedrock): Claude via Amazon Bedrock. Needs an AWS region
# and credentials from the standard AWS provider chain; the account must have
# Bedrock access to the Claude models.
# AWS_REGION="us-east-1"

# ── Email (SMTP) — Optional ──────────────────────────────────
# Required for email notifications, password reset, etc.
#
# For local development use Mailpit from docker-compose.dev.yml. It accepts
# every message, delivers none of them, and shows you the result at
# http://localhost:8025 — so you can exercise the email paths with no
# credentials and no chance of mailing a real patient:
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"
#   SMTP_SECURE="false"
#   SMTP_USER=""
#   SMTP_PASSWORD=""
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ── SMS Gateway — Optional ───────────────────────────────────
# Required for SMS appointment reminders
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"

# ── Video Consultation — Optional ─────────────────────────────
# Jitsi Meet (free, no API key needed)
JITSI_DOMAIN="meet.jit.si"
# Or use Daily.co (requires API key):
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-domain.daily.co"
