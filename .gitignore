/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env
.env.*
.env copy
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# Prisma
# migration_lock.toml records the datasource provider and MUST be committed —
# `prisma migrate` errors without it. Do not add it back here.

# Uploads
/uploads/*
!/uploads/.gitkeep

# Logs
# Anchored to the repo root on purpose. A bare `logs/` matches at ANY depth and
# silently excluded app/api/sterilization/logs/ and the matching dashboard page
# from the repository.
/logs/
*.log

# Windows reserved names (can't be deleted normally)
**/nul
